---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import CTABanner from '../../components/common/CTABanner.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCollection } from 'astro:content';
import { productCategories } from '../../data/company';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);

const counts = products.reduce<Record<string, number>>((acc, product) => {
  acc[product.data.category] = (acc[product.data.category] ?? 0) + 1;
  return acc;
}, {});

const filters = [
  { slug: 'all', label: 'All equipment', count: products.length },
  ...productCategories.map((category) => ({
    slug: category.slug,
    label: category.label,
    count: counts[category.slug] ?? 0,
  })),
];

const availabilityLabels: Record<string, string> = {
  'in-stock': 'In stock',
  'made-to-order': 'Made to order',
  engineered: 'Engineered to order',
};
---

<Base
  title="Products"
  description="Explore EOT cranes, goliath cranes, jib cranes, wire rope hoists, crane components and custom lifting systems manufactured by Swaraj Engineering Corporation."
>
  <section class="relative overflow-hidden border-b border-border bg-brand-900 text-white">
    <div class="absolute inset-0 grid-pattern opacity-40" aria-hidden="true"></div>
    <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent-400/10 blur-[90px]" aria-hidden="true"></div>

    <div class="container-page relative py-12 md:py-16">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Products' }]} tone="dark" />

      <div class="mt-6 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow eyebrow-inverse mb-4">Product range</p>
          <h1 class="text-display-lg text-white">Cranes, hoists and components</h1>
          <p class="mt-4 text-body-lg text-slate-300">
            Every machine is configured to the building and the duty cycle. Filter by family, availability or search
            for a capacity to find a starting point — we will engineer the rest.
          </p>
        </div>

        <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-lg bg-white/10">
          <div class="bg-brand-900/80 px-4 py-4">
            <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-400">Families</dt>
            <dd class="mt-1 font-display text-xl font-bold text-white">6</dd>
          </div>
          <div class="bg-brand-900/80 px-4 py-4">
            <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-400">Capacity</dt>
            <dd class="mt-1 font-display text-xl font-bold text-white">100 T</dd>
          </div>
          <div class="bg-brand-900/80 px-4 py-4">
            <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-400">Basis</dt>
            <dd class="mt-1 font-display text-xl font-bold text-white">IS 3177</dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="stripe-divider h-1.5 w-full" aria-hidden="true"></div>
  </section>

  <section class="py-10 md:py-14">
    <div class="container-page">
      <div
        class="sticky top-[calc(var(--header-height)+0.75rem)] z-30 rounded-xl border border-border bg-white/95 p-4 shadow-sm backdrop-blur-md md:p-5"
        data-product-filters
      >
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by product family">
            {filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.slug}
                aria-pressed={filter.slug === 'all' ? 'true' : 'false'}
                class:list={[
                  'inline-flex items-center gap-2 rounded-full border px-3.5 py-2 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors',
                  filter.slug === 'all'
                    ? 'border-brand-500 bg-brand-500 text-white'
                    : 'border-border-strong bg-white text-text-muted hover:border-brand-400 hover:text-brand-500',
                ]}
              >
                {filter.label}
                <span
                  class:list={[
                    'rounded-full px-1.5 py-0.5 text-[9px]',
                    filter.slug === 'all' ? 'bg-white/20 text-white' : 'bg-bg-muted text-text-muted',
                  ]}
                >
                  {filter.count}
                </span>
              </button>
            ))}
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="relative">
              <Icon
                name="search"
                size={15}
                class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-muted"
              />
              <input
                type="search"
                placeholder="Search model, capacity or SKU"
                aria-label="Search products"
                class="h-10 w-full rounded-md border border-border-strong bg-white pl-9 pr-3 text-sm text-ink shadow-sm outline-none transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15 sm:w-64"
                data-search
              />
            </div>

            <div class="relative">
              <select
                aria-label="Filter by availability"
                class="h-10 w-full appearance-none rounded-md border border-border-strong bg-white pl-3 pr-9 text-sm text-ink shadow-sm outline-none transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15 sm:w-48"
                data-availability
              >
                <option value="all">All availability</option>
                <option value="in-stock">In stock</option>
                <option value="made-to-order">Made to order</option>
                <option value="engineered">Engineered to order</option>
              </select>
              <svg
                class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between gap-4 border-t border-border pt-3">
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-muted" data-result-count aria-live="polite">
            Showing {products.length} of {products.length} systems
          </p>
          <button
            type="button"
            class="hidden font-mono text-[10px] uppercase tracking-[0.12em] text-brand-500 underline underline-offset-4"
            data-clear
          >
            Clear filters
          </button>
        </div>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <div
            data-product-item
            data-category={product.data.category}
            data-availability={product.data.availability}
            data-search={`${product.data.title} ${product.data.shortDescription} ${product.data.sku} ${product.data.specs.capacity} ${product.data.specs.span ?? ''} ${product.data.industries.join(' ')} ${availabilityLabels[product.data.availability]}`}
          >
            <ProductCard product={product} class="h-full" />
          </div>
        ))}
      </div>

      <div class="mt-10 hidden rounded-xl border border-dashed border-border-strong bg-bg-muted px-6 py-14 text-center" data-empty>
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-text-muted shadow-sm">
          <Icon name="search" size={22} />
        </span>
        <h2 class="mt-4 font-display text-lg font-bold text-ink">No systems match those filters</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-text-muted">
          Try a different capacity or family. If your requirement is unusual, that is exactly what we engineer for.
        </p>
        <a href="/contact" class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-brand-500">
          Describe your requirement
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    eyebrow="Need help narrowing it down?"
    title="Send us the load. We will scope the crane."
    description="Capacity, span, lift height and a site photo are enough to start. Our engineering team will recommend the right family and configuration."
  />
</Base>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-product-filters]');

  if (toolbar) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-product-item]'));
    const buttons = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const search = toolbar.querySelector<HTMLInputElement>('[data-search]');
    const availability = toolbar.querySelector<HTMLSelectElement>('[data-availability]');
    const count = toolbar.querySelector<HTMLElement>('[data-result-count]');
    const clear = toolbar.querySelector<HTMLButtonElement>('[data-clear]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    const activeClasses = ['border-brand-500', 'bg-brand-500', 'text-white'];
    const inactiveClasses = ['border-border-strong', 'bg-white', 'text-text-muted', 'hover:border-brand-400', 'hover:text-brand-500'];

    const params = new URLSearchParams(window.location.search);
    const requested = params.get('category') ?? 'all';
    let activeCategory = buttons.some((button) => button.dataset.filter === requested) ? requested : 'all';

    const setButtonState = () => {
      buttons.forEach((button) => {
        const active = button.dataset.filter === activeCategory;
        button.setAttribute('aria-pressed', String(active));
        activeClasses.forEach((name) => button.classList.toggle(name, active));
        inactiveClasses.forEach((name) => button.classList.toggle(name, !active));
        const badge = button.querySelector('span');
        if (badge) {
          badge.classList.toggle('bg-white/20', active);
          badge.classList.toggle('text-white', active);
          badge.classList.toggle('bg-bg-muted', !active);
          badge.classList.toggle('text-text-muted', !active);
        }
      });
    };

    const updateUrl = () => {
      const next = new URL(window.location.href);
      if (activeCategory === 'all') next.searchParams.delete('category');
      else next.searchParams.set('category', activeCategory);
      window.history.replaceState({}, '', next);
    };

    const apply = () => {
      const query = (search?.value ?? '').toLowerCase().trim();
      const availabilityValue = availability?.value ?? 'all';
      let visible = 0;

      items.forEach((item) => {
        const haystack = (item.dataset.search ?? '').toLowerCase();
        const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
        const matchesAvailability = availabilityValue === 'all' || item.dataset.availability === availabilityValue;
        const matchesQuery = query.length === 0 || haystack.includes(query);
        const matches = matchesCategory && matchesAvailability && matchesQuery;

        item.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      if (count) {
        count.textContent = `Showing ${visible} of ${items.length} systems`;
      }
      if (empty) {
        empty.classList.toggle('hidden', visible !== 0);
      }
      if (clear) {
        const filtered = activeCategory !== 'all' || query.length > 0 || availabilityValue !== 'all';
        clear.classList.toggle('hidden', !filtered);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.filter ?? 'all';
        setButtonState();
        updateUrl();
        apply();
      });
    });

    search?.addEventListener('input', apply);
    availability?.addEventListener('change', apply);

    clear?.addEventListener('click', () => {
      activeCategory = 'all';
      if (search) search.value = '';
      if (availability) availability.value = 'all';
      setButtonState();
      updateUrl();
      apply();
    });

    setButtonState();
    apply();
  }
</script>
