---
type BadgeVariant = 'brand' | 'accent' | 'success' | 'outline' | 'dark' | 'muted';
type BadgePreset =
  | 'new'
  | 'featured'
  | 'best-seller'
  | 'in-stock'
  | 'made-to-order'
  | 'engineered'
  | 'custom'
  | 'iso';

interface Props {
  variant?: BadgeVariant;
  preset?: BadgePreset;
  size?: 'sm' | 'md';
  dot?: boolean;
  class?: string;
}

const { variant, preset, size = 'sm', dot, class: className = '' } = Astro.props;

const presets: Record<BadgePreset, { label: string; variant: BadgeVariant; dot?: boolean }> = {
  new: { label: 'New', variant: 'accent' },
  featured: { label: 'Featured', variant: 'brand' },
  'best-seller': { label: 'Best seller', variant: 'accent' },
  'in-stock': { label: 'In stock', variant: 'success', dot: true },
  'made-to-order': { label: 'Made to order', variant: 'brand' },
  engineered: { label: 'Engineered', variant: 'accent' },
  custom: { label: 'Custom', variant: 'outline' },
  iso: { label: 'ISO 9001:2015', variant: 'success' },
};

const selected = preset ? presets[preset] : undefined;
const resolvedVariant: BadgeVariant = variant ?? selected?.variant ?? 'brand';
const resolvedDot = dot ?? selected?.dot ?? false;
const hasSlot = Astro.slots.has('default');

const variants: Record<BadgeVariant, string> = {
  brand: 'bg-brand-50 text-brand-600 ring-1 ring-brand-100',
  accent: 'bg-accent-400/20 text-accent-700 ring-1 ring-accent-400/40',
  success: 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200',
  outline: 'bg-transparent text-text-muted ring-1 ring-border-strong',
  dark: 'bg-white/10 text-white ring-1 ring-white/15',
  muted: 'bg-slate-100 text-slate-600 ring-1 ring-slate-200',
};

const sizes: Record<string, string> = {
  sm: 'px-2.5 py-1 text-[11px]',
  md: 'px-3 py-1.5 text-xs',
};

const classes = [
  'inline-flex items-center gap-1.5 rounded-sm font-mono uppercase tracking-[0.1em]',
  variants[resolvedVariant],
  sizes[size],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  {resolvedDot && <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>}
  {hasSlot ? <slot /> : selected?.label}
</span>
