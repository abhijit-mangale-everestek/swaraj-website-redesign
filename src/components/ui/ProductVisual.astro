const artContent = art[category] ?? art.custom;
---

<div class:list={['relative overflow-hidden', tones[tone], className]}>
  <div class:list={['absolute inset-0 opacity-70', gridClass]} aria-hidden="true"></div>
  <div
    class:list={[
      'absolute -right-12 -top-12 h-44 w-44 rounded-full blur-3xl',
      tone === 'accent' ? 'bg-white/30' : tone === 'blueprint' ? 'bg-brand-400/25' : 'bg-accent-400/15',
    ]}
    aria-hidden="true"
  >
  </div>
  <svg
    viewBox="0 0 400 300"
    class="relative h-full w-full"
    fill="none"
    aria-hidden="true"
    role="presentation"
    set:html={artContent}
  >
  </svg>
  {label && (
    <span
      class:list={[
        'absolute left-4 top-4 rounded-sm border px-2 py-1 font-mono text-[10px] uppercase tracking-[0.18em] backdrop-blur-sm',
        tone === 'accent'
          ? 'border-brand-900/20 bg-white/20 text-brand-900'
          : tone === 'blueprint'
            ? 'border-brand-500/20 bg-white/60 text-brand-600'
            : 'border-white/20 bg-white/10 text-white/80',
      ]}
    >
      {label}
    </span>
  )}
  {capacity && (
    <span
      class:list={[
        'absolute bottom-4 left-4 font-mono text-xs uppercase tracking-[0.16em]',
        tone === 'accent' ? 'text-brand-900/80' : tone === 'blueprint' ? 'text-brand-600/80' : 'text-white/70',
      ]}
    >
      {capacity}
    </span>
  )}
</div>
