---
interface Option {
  value: string;
  label: string;
}

interface Props {
  label: string;
  name: string;
  id?: string;
  options: Option[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  hint?: string;
  error?: string;
  class?: string;
  disabled?: boolean;
  optional?: boolean;
}

const {
  label,
  name,
  id = name,
  options,
  value,
  placeholder = 'Select an option',
  required = false,
  hint,
  error,
  class: className = '',
  disabled = false,
  optional = false,
} = Astro.props;

const describedBy = error ? `${id}-error` : hint ? `${id}-hint` : undefined;
---

<div class:list={['space-y-1.5', className]}>
  <label for={id} class="flex items-baseline justify-between gap-3 text-sm font-medium text-ink">
    <span>{label}{required && <span class="ml-0.5 text-error-500" aria-hidden="true">*</span>}</span>
    {optional && <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-muted">Optional</span>}
  </label>
  <div class="relative">
    <select
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class:list={[
        'h-11 w-full appearance-none rounded-md border bg-white px-3.5 pr-10 text-[0.9375rem] text-ink shadow-sm outline-none transition-colors duration-150',
        value ? 'text-ink' : 'text-slate-500',
        error ? 'border-error-500 focus:border-error-500 focus:ring-2 focus:ring-error-500/20' : 'border-border-strong focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15',
        disabled ? 'cursor-not-allowed opacity-60' : '',
      ]}
    >
      <option value="" disabled selected={!value}>{placeholder}</option>
      {options.map((option) => (
        <option value={option.value} selected={option.value === value}>{option.label}</option>
      ))}
    </select>
    <svg
      class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
  {error && <p id={`${id}-error`} class="text-xs font-medium text-error-500">{error}</p>}
  {hint && !error && <p id={`${id}-hint`} class="text-xs text-text-muted">{hint}</p>}
</div>
