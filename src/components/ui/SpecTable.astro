---
interface Spec {
  label: string;
  value: string;
  mono?: boolean;
  highlight?: boolean;
}

interface Props {
  specs: Spec[];
  columns?: 1 | 2;
  dense?: boolean;
  stickyHeader?: boolean;
  caption?: string;
  class?: string;
}

const {
  specs,
  dense = false,
  stickyHeader = true,
  caption = 'Technical specifications',
  class: className = '',
} = Astro.props;

const cellY = dense ? 'py-2.5' : 'py-3.5';
const headerCell = [
  'sticky z-10 border-b border-border bg-bg-muted px-5 text-left font-mono text-[10px] uppercase tracking-[0.14em] text-text-muted',
  dense ? 'py-2.5' : 'py-3',
  stickyHeader ? 'top-[calc(var(--header-height)+1rem)]' : '',
].filter(Boolean).join(' ');
---

<div class:list={['overflow-hidden rounded-lg border border-border bg-white', className]}>
  <div class="divide-y divide-border md:hidden">
    {specs.map((spec) => (
      <div
        class:list={[
          'flex items-baseline justify-between gap-5 px-4',
          dense ? 'py-2.5' : 'py-3.5',
          spec.highlight ? 'border-l-2 border-l-accent-400 bg-brand-50' : '',
        ]}
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-muted">{spec.label}</span>
        <span
          class:list={[
            'text-right text-sm font-semibold text-ink',
            spec.mono !== false ? 'font-mono text-[0.8125rem] tracking-tight' : '',
          ]}
        >
          {spec.value}
        </span>
      </div>
    ))}
  </div>

  <div class="hidden md:block">
    <table class="w-full border-collapse text-left">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class={headerCell}>Specification</th>
          <th scope="col" class:list={[headerCell, 'text-right']}>Value</th>
        </tr>
      </thead>
      <tbody>
        {specs.map((spec) => (
          <tr
            class:list={[
              'border-b border-border last:border-b-0 transition-colors hover:bg-bg-muted/70',
              spec.highlight ? 'bg-brand-50 hover:bg-brand-50' : '',
            ]}
          >
            <th scope="row" class:list={['px-5 text-left text-sm font-normal text-text-muted', cellY]}>
              {spec.label}
            </th>
            <td
              class:list={[
                'px-5 text-right text-sm font-semibold text-ink',
                cellY,
                spec.mono !== false ? 'font-mono text-[0.8125rem] tracking-tight' : '',
              ]}
            >
              {spec.value}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
