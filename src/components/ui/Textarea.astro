---
interface Props {
  label: string;
  name: string;
  id?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  hint?: string;
  error?: string;
  class?: string;
}

const {
  label,
  name,
  id = name,
  value,
  placeholder,
  rows = 4,
  required = false,
  hint,
  error,
  class: className = '',
} = Astro.props;

const describedBy = error ? `${id}-error` : hint ? `${id}-hint` : undefined;
---

<div class:list={['space-y-1.5', className]}>
  <label for={id} class="text-sm font-medium text-ink">
    {label}{required && <span class="ml-0.5 text-error-500" aria-hidden="true">*</span>}
  </label>
  <textarea
    id={id}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    class:list={[
      'w-full rounded-md border bg-white px-3.5 py-3 text-[0.9375rem] text-ink shadow-sm outline-none transition-colors duration-150 placeholder:text-slate-400',
      error ? 'border-error-500 focus:border-error-500 focus:ring-2 focus:ring-error-500/20' : 'border-border-strong focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15',
    ]}
  >{value}</textarea>
  {error && <p id={`${id}-error`} class="text-xs font-medium text-error-500">{error}</p>}
  {hint && !error && <p id={`${id}-hint`} class="text-xs text-text-muted">{hint}</p>}
</div>
