---
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost' | 'danger' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  class?: string;
  target?: string;
  id?: string;
  name?: string;
  value?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  loading = false,
  fullWidth = false,
  class: className = '',
  target,
  id,
  name,
  value,
  'aria-label': ariaLabel,
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base =
  'group relative inline-flex select-none items-center justify-center gap-2 rounded-md font-body font-medium transition-all duration-200 ease-industrial focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50';

const variants: Record<string, string> = {
  primary:
    'bg-brand-500 text-white shadow-sm hover:bg-brand-600 hover:shadow-md active:bg-brand-700 focus-visible:ring-brand-500 focus-visible:ring-offset-white',
  secondary:
    'border border-border-strong bg-white text-ink shadow-sm hover:border-brand-500 hover:bg-brand-50 hover:text-brand-600 active:bg-brand-100 focus-visible:ring-brand-500',
  accent:
    'bg-accent-400 text-brand-900 shadow-sm hover:bg-accent-500 hover:shadow-md active:bg-accent-600 focus-visible:ring-accent-500 focus-visible:ring-offset-white',
  ghost:
    'border border-white/25 bg-white/5 text-white backdrop-blur-sm hover:border-white/50 hover:bg-white/10 active:bg-white/15 focus-visible:ring-white focus-visible:ring-offset-brand-900',
  danger:
    'bg-error-500 text-white shadow-sm hover:bg-red-600 active:bg-red-700 focus-visible:ring-error-500 focus-visible:ring-offset-white',
  inverse:
    'bg-white text-brand-900 shadow-sm hover:bg-brand-50 active:bg-brand-100 focus-visible:ring-white focus-visible:ring-offset-brand-900',
};

const sizes: Record<string, string> = {
  sm: 'h-9 px-3.5 text-sm',
  md: 'h-11 px-5 text-[0.9375rem]',
  lg: 'h-[3.25rem] px-7 text-base',
};

const classes = [
  base,
  variants[variant],
  sizes[size],
  fullWidth ? 'w-full' : '',
  className,
].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || loading}
  aria-disabled={href && (disabled || loading) ? 'true' : undefined}
  aria-busy={loading ? 'true' : undefined}
  id={id}
  name={name}
  value={value}
  aria-label={ariaLabel}
>
  {loading && (
    <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.25"></circle>
      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
    </svg>
  )}
  <slot />
  {!loading && href && (
    <Icon name="arrow-right" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5" />
  )}
</Tag>
