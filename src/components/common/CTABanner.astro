---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  class?: string;
}

const {
  eyebrow = 'Start a project',
  title = 'Ready to spec your next crane?',
  description = 'Send us your capacity, span and site constraints. We will return a technical proposal with drawings, duty class and lead time.',
  primary = { label: 'Request a quote', href: '/contact' },
  secondary = { label: 'Download catalogue', href: '/contact' },
  class: className = '',
} = Astro.props;
---

<section class:list={['relative overflow-hidden bg-accent-400', className]}>
  <div class="absolute inset-0 grid-pattern-light opacity-70" aria-hidden="true"></div>
  <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-white/40 blur-3xl" aria-hidden="true"></div>

  <div class="container-page relative py-14 md:py-20">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4 text-brand-900/70 before:bg-brand-900/40">{eyebrow}</p>
        <h2 class="text-display-lg text-brand-900">{title}</h2>
        <p class="mt-4 max-w-xl text-body-lg text-brand-900/75">{description}</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <Button href={primary.href} size="lg">{primary.label}</Button>
        <Button href={secondary.href} variant="secondary" size="lg" class="border-brand-900/25 bg-transparent text-brand-900 hover:border-brand-900 hover:bg-brand-900/5 hover:text-brand-900">
          {secondary.label}
        </Button>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-brand-900/15 pt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-brand-900/70">
      <span class="flex items-center gap-2"><Icon name="clock" size={13} /> Response in 1 working day</span>
      <span class="flex items-center gap-2"><Icon name="factory" size={13} /> In-house manufacturing</span>
      <span class="flex items-center gap-2"><Icon name="shield" size={13} /> IS 3177 compliant</span>
    </div>
  </div>
</section>
