---
import Icon from '../ui/Icon.astro';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
  tone?: 'light' | 'dark';
  class?: string;
}

const { items, tone = 'light', class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={['flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em]', className]}>
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && (
          <Icon
            name="chevron-right"
            size={11}
            class={tone === 'dark' ? 'text-slate-600' : 'text-border-strong'}
          />
        )}
        {item.href && index < items.length - 1 ? (
          <a
            href={item.href}
            class:list={[
              'transition-colors',
              tone === 'dark' ? 'text-slate-400 hover:text-accent-400' : 'text-text-muted hover:text-brand-500',
            ]}
          >
            {item.label}
          </a>
        ) : (
          <span class:list={[tone === 'dark' ? 'text-slate-200' : 'text-ink']} aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
