---
import Button from '../ui/Button.astro';

interface Cta {
  label: string;
  href: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  description?: string;
  primary?: Cta;
  secondary?: Cta;
  stats?: Stat[];
  note?: string;
}

const {
  eyebrow,
  title,
  accent,
  description,
  primary,
  secondary,
  stats,
  note,
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  <div class="absolute inset-0 grid-pattern opacity-40" aria-hidden="true"></div>
  <div
    class="absolute -left-32 top-1/3 h-96 w-96 rounded-full bg-brand-500/25 blur-[100px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -right-20 -top-24 h-96 w-96 rounded-full bg-accent-400/10 blur-[100px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative">
    <div class="grid items-center gap-12 pb-16 pt-14 md:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pb-24">
      <div class="max-w-2xl">
        {eyebrow && <p class="eyebrow eyebrow-inverse mb-5">{eyebrow}</p>}
        <h1 class="text-display-xl text-white">
          {title}
          {accent && <span class="text-accent-400">{accent}</span>}
        </h1>
        {description && <p class="mt-6 max-w-xl text-body-lg text-slate-300">{description}</p>}

        {(primary || secondary) && (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            {primary && <Button href={primary.href} variant="accent" size="lg">{primary.label}</Button>}
            {secondary && <Button href={secondary.href} variant="ghost" size="lg">{secondary.label}</Button>}
          </div>
        )}

        {note && (
          <p class="mt-5 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-slate-400">
            <span class="h-1.5 w-1.5 rounded-full bg-success-500"></span>
            {note}
          </p>
        )}

        {stats && stats.length > 0 && (
          <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-white/10 pt-8 sm:grid-cols-3">
            {stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="block font-display text-2xl font-bold tracking-tight text-white md:text-3xl">{stat.value}</span>
                  <span class="mt-1 block text-xs leading-snug text-slate-400">{stat.label}</span>
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="relative">
        <slot />
      </div>
    </div>
  </div>
  <div class="stripe-divider h-1.5 w-full" aria-hidden="true"></div>
</section>
