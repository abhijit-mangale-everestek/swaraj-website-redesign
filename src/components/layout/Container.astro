---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'main' | 'nav';
  gutter?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
}

const {
  size = 'xl',
  as: Tag = 'div',
  gutter = 'md',
  class: className = '',
  id,
} = Astro.props;

const widths: Record<string, string> = {
  sm: 'max-w-[640px]',
  md: 'max-w-[768px]',
  lg: 'max-w-[1024px]',
  xl: 'max-w-[1280px]',
  full: 'max-w-none',
};

const gutters: Record<string, string> = {
  none: '',
  sm: 'px-4',
  md: 'px-5 md:px-8',
  lg: 'px-6 md:px-12',
};

const classes = ['mx-auto w-full', widths[size], gutters[gutter], className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} id={id}>
  <slot />
</Tag>
