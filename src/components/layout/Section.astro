---
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'muted' | 'dark';
  spacing?: 'none' | 'sm' | 'md' | 'lg';
  container?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  as?: 'section' | 'div' | 'article';
  class?: string;
  headerClass?: string;
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  tone = 'light',
  spacing = 'md',
  container = 'xl',
  as: Tag = 'section',
  class: className = '',
  headerClass = '',
  id,
} = Astro.props;

const center = align === 'center';
const hasHeader = Boolean(eyebrow || title || description) || Astro.slots.has('actions');

const tones: Record<string, string> = {
  light: '',
  muted: 'bg-bg-muted',
  dark: 'bg-brand-900 text-white',
};

const spacings: Record<string, string> = {
  none: '',
  sm: 'py-10 md:py-14',
  md: 'py-16 md:py-24',
  lg: 'py-20 md:py-32',
};

const classes = ['relative', tones[tone], spacings[spacing], className].filter(Boolean).join(' ');
---

<Tag id={id} class={classes}>
  <Container size={container}>
    {hasHeader && (
      <div
        class:list={[
          'mb-10 md:mb-14',
          center ? 'mx-auto max-w-3xl text-center' : 'flex flex-col gap-6 md:flex-row md:items-end md:justify-between',
          headerClass,
        ]}
      >
        <div class:list={[center ? '' : 'max-w-3xl']}>
          {eyebrow && (
            <p class:list={['eyebrow mb-4', tone === 'dark' ? 'eyebrow-inverse' : '']}>{eyebrow}</p>
          )}
          {title && (
            <h2 class:list={['text-display-lg', tone === 'dark' ? 'text-white' : 'text-ink']}>{title}</h2>
          )}
          {description && (
            <p class:list={['mt-4 text-body-lg', tone === 'dark' ? 'text-slate-300' : 'text-text-muted']}>
              {description}
            </p>
          )}
        </div>
        {Astro.slots.has('actions') && (
          <div class:list={['flex flex-wrap items-center gap-3', center ? 'justify-center' : 'shrink-0']}>
            <slot name="actions" />
          </div>
        )}
      </div>
    )}
    <slot />
  </Container>
</Tag>
